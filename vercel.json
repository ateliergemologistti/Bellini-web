{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/producto", "destination": "/product-detail.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/terminos-y-condiciones", "destination": "/terminos-y-condiciones.html" },
    { "source": "/politica-de-privacidad", "destination": "/politica-de-privacidad.html" },
    { "source": "/politica-de-cookies", "destination": "/politica-de-cookies.html" },
    { "source": "/recojos-y-envios", "destination": "/recojos-y-envios.html" }
  ]
}
